# Copiar a .env y completar. .env NO se versiona.

# --- Base de datos ---
POSTGRES_USER=wpa
POSTGRES_DB=wpa
# Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIAR

# --- Red del host (detectada en el preflight) ---
# Resolver(es) DNS upstream reales (NO 127.0.0.53), separados por comas: `resolvectl status`.
# Si el host cambia de red, actualizar estos tres valores y ejecutar `docker compose up -d`.
UPSTREAM_DNS=CAMBIAR
# Gateway e IP LAN del host: `ip route` / `ip -br a`. Usados por los tests SSRF.
LAN_GATEWAY=CAMBIAR
HOST_LAN_IP=CAMBIAR

# --- Publicación de puertos ---
API_PORT=8000
FRONTEND_PORT=8080

# --- Límites de la API ---
# Scans nuevos por IP en la ventana, y tope de jobs en cola (429 RATE_LIMITED / QUEUE_FULL).
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_S=60
MAX_QUEUED_JOBS=20
# Máximo de scans de un Privacy Test (escenarios × perfiles × corridas).
MAX_GROUP_JOBS=10
# Comparación de visitas (v1.5.2): segundos entre la visita 1 y la 2 si la petición no dice otro (0–86400).
VISIT_COMPARISON_INTERVAL_S=300

# --- Límites (SPEC §Límites) ---
MAX_CONCURRENT_SCANS=2
# v1.5.0: carga + protocolo de visita (data/visit_protocol.yaml: esperas de 3 s, scroll ≤ 8 s, cierre 3 s).
SCAN_TIMEOUT_S=90
MAX_REQUESTS=1500
MAX_BODY_CAPTURE_BYTES=65536

# --- País de la IP de salida (v1.5.0, docs/adr/038) ---
# Servicio de IP pública consultado una vez por scan a través del egress-proxy, fuera del tráfico analizado.
# La IP se geolocaliza con DB-IP Lite (data/ipdb) y se descarta. Vacío = no se consulta nada y el país
# queda «desconocido».
EGRESS_IP_SERVICE_URL=https://api.ipify.org

# --- Worker ---
WORKER_MEM_LIMIT=4g
WORKER_CPUS=4.0
# Ver docs/adr/001-chromium-sandbox.md
CHROMIUM_SANDBOX=true
LOG_LEVEL=INFO
# Instrumentación de APIs de fingerprinting en cada scan (docs/adr/007).
FP_INSTRUMENTATION=true
# Perfil base del navegador del worker (v1.4.5): idioma (BCP 47) y zona horaria (IANA). De aquí salen
# navigator.language, Accept-Language («es-CL,es;q=0.9») y la zona de Intl; deben apuntar al mismo país.
WORKER_LOCALE=es-CL
WORKER_TIMEZONE=America/Santiago

# --- Tests de captura (F2) ---
# 1 = el proxy, la api y el worker aceptan el sitio de fixtures (*.fixtures.test).
# Solo para stacks de test, junto con `docker compose --profile test up -d`.
# En cualquier otro despliegue debe ser 0. Ver docs/adr/003-fixtures-de-captura.md.
ALLOW_FIXTURES=0

# --- Mi exposición / comparación grupal de huellas (F6) ---
# La sala de comparación vive en memoria y se borra sola pasado este tiempo.
EXPOSURE_TTL_S=7200
EXPOSURE_MAX_PARTICIPANTS=500
# Token para que el presentador purgue la sala desde la interfaz. Vacío = desactivado.
# Generar con: openssl rand -hex 16
EXPOSURE_PRESENTER_TOKEN=

# --- Modo demo de exposición (scripts/demo.sh, DEMO_MODE=exposure) ---
# Puertos que se publican en la IP LAN solo en ese modo.
EXPOSURE_HTTP_PORT=8088
EXPOSURE_HTTPS_PORT=8443

# --- Atribución de conexiones en el proxy (F8) ---
# Secreto compartido entre el worker y el proxy. Generar con: openssl rand -hex 24
PROXY_SCAN_SECRET=CAMBIAR

# --- Reportes exportables (F8) ---
# Marca opcional en el encabezado de los reportes HTML/PDF. Vacío = encabezado neutro.
REPORT_BRAND_NAME=
# Directorio del host, FUERA del repo y con ruta absoluta, con `logo.png` o `logo.jpg` (máx. 300 KB)
# y, si no se usa REPORT_BRAND_NAME, `nombre.txt`. Sin definir, no hay logo.
# REPORT_BRAND_DIR=/ruta/absoluta/a/mi-marca
# Tamaño máximo del log de conexiones del proxy antes de rotar (bytes).
SCANLOG_MAX_BYTES=20000000

# --- Licencias de las fuentes de datos (F9, docs/adr/019) ---
# no_comercial (por defecto): usa el mapa de entidades de DuckDuckGo (CC BY-NC-SA) y la lista de
#   CMP de IAB (sin licencia explícita). NO apto para uso comercial.
# comercial: excluye ambas; organizaciones según AdGuard companiesdb (CC BY-SA 4.0), que hay que
#   descargar antes con ./scripts/update-companiesdb.sh.
LICENSE_PROFILE=no_comercial

# --- Retención de datos (F9) ---
# Los scans terminados (y sus reportes) más antiguos que estos días se borran solos. 0 = nunca.
# Purga manual: ./scripts/purge.sh [días] [--dry-run]
SCAN_RETENTION_DAYS=30

# --- Captura interactiva (v1.4, docs/adr/029) ---
# Una sesión a la vez. Se cierra sola tras INTERACTIVE_IDLE_S segundos sin teclado ni ratón, o al
# llegar a INTERACTIVE_MAX_S; también al alcanzar INTERACTIVE_MAX_REQUESTS. No disponible en modo demo.
INTERACTIVE_IDLE_S=600
INTERACTIVE_MAX_S=1800
INTERACTIVE_MAX_REQUESTS=4000

# --- Indicador de recursos (v1.4) ---
# Aviso visual cuando la RAM de un contenedor supera este porcentaje de su límite.
RESOURCES_MEMORY_ALERT_PERCENT=85
